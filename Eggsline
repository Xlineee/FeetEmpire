local function refreshStats(state)
    footerText.Text = stats.lastAction
    if not state or not state.company then return end
    local c = state.company
    local hours = math.max((os.clock() - stats.startClock) / 3600, 1 / 3600)
    local cash = c.cash or 0
    local cashDelta = cash - (stats.startCash or cash)
    local deliv = (state.stats and state.stats.deliveries or 0)
    local delivDelta = deliv - (stats.startDeliveries or deliv)

    local idle, enroute, broken = 0, 0, 0
    for _, v in pairs(c.vehicles or {}) do
        if v.status == "Idle" then idle += 1 elseif v.status == "Broken" then broken += 1 else enroute += 1 end
    end
    local cap = c.fuelCapacity or 0

    statLabels["Uptime"].Text = fmtTime(os.clock() - stats.startClock)
    statLabels["Cash"].Text = fmt(cash)
    statLabels["Session cash"].Text = (cashDelta >= 0 and "+" or "") .. fmt(cashDelta)
    statLabels["Cash / hour"].Text = fmt(cashDelta / hours)
    statLabels["Session deliveries"].Text = tostring(delivDelta)
    statLabels["Deliveries / hour"].Text = string.format("%.1f", delivDelta / hours)
    statLabels["Fuel"].Text = cap > 0 and string.format("%.0f%%  (%d/%d gal)", (c.fuel or 0) / cap * 100, math.floor(c.fuel or 0), math.floor(cap)) or "-"
    statLabels["Trucks"].Text = string.format("Idle %d • Driving %d • Broken %d", idle, enroute, broken)
    statLabels["Dispatch"].Text = string.format("NPC %d • Own %d • Reposition %d", stats.dispatchDriver, stats.dispatchSelf, stats.repositions)
    statLabels["Bank"].Text = fmt(c.bank and c.bank.balance or 0)
    statLabels["Withdraw"].Text = string.format("%dx • %s", stats.withdraws, fmt(stats.withdrawn))
    statLabels["Refuel"].Text = string.format("%dx • %d gal • ~%s", stats.refuels, stats.gallons, fmt(stats.fuelSpent))
    statLabels["Repair"].Text = string.format("%dx • %s", stats.repairs, fmt(stats.repairSpent))
    statLabels["Claims"].Text = string.format("Daily %d • Playtime %d • Offline %d", stats.daily, stats.playtime, stats.offline)
    statLabels["Action"].Text = stats.lastAction
end

-- ===== animasi buka / tutup / minimize =====
local visible, minimized, busy = false, false, false

local function openAnim()
    visible = true
    main.Visible = true
    tween(scale, 0.55, { Scale = fit }, Enum.EasingStyle.Back)
    tween(main, 0.35, { GroupTransparency = 0 })
end

local function closeAnim(done)
    visible = false
    tween(scale, 0.3, { Scale = fit * 0.86 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    tween(main, 0.3, { GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    task.delay(0.32, function()
        main.Visible = false
        if done then done() end
    end)
end

local function cleanup()
    env.FleetEmpireRun = -1
    setAntiAfk(false)
    pcall(setHideIdentity, false)
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
end
env.FleetEmpireCleanup = cleanup

closeBtn.MouseButton1Click:Connect(function()
    if busy then return end
    busy = true
    closeAnim(cleanup)
end)

-- ===== ukuran window: selalu menjaga pojok kiri-atas tetap di tempat =====
local winBusyUntil = 0
local function setWindowSize(w, h, animate, duration)
    local s_ = scale.Scale
    local cur = main.Size
    local pos = main.Position
    local newPos = UDim2.new(
        pos.X.Scale, pos.X.Offset + (w - cur.X.Offset) * s_ / 2,
        pos.Y.Scale, pos.Y.Offset + (h - cur.Y.Offset) * s_ / 2
    )
    if animate then
        tween(main, duration or 0.45, { Size = UDim2.fromOffset(w, h), Position = newPos }, Enum.EasingStyle.Quint)
    else
        main.Size = UDim2.fromOffset(w, h)
        main.Position = newPos
    end
end

local function maxWindowSize()
    local s_ = scale.Scale
    local g = gui.AbsoluteSize
    local tl = main.AbsolutePosition - gui.AbsolutePosition
    return math.max(math.floor((g.X - tl.X - 8) / s_), MIN_W), math.max(math.floor((g.Y - tl.Y - 8) / s_), MIN_H)
end

