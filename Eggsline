            BackgroundTransparency = 0.88, BorderSizePixel = 0,
        }, r)
    end
    new("TextLabel", {
        Size = labelW or UDim2.new(0.5, -14, 1, 0), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1, Text = label,
        TextColor3 = C.white, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    }, r)
    return r
end

