-- Lebar window >= SINGLE_COL_W  -> 2 kolom (landscape)
-- Lebar window <  SINGLE_COL_W  -> 1 kolom (portrait), baris-baris menyesuaikan lebar
local SINGLE_COL_W = 580
local adaptives = {} -- fungsi(lebarKolom) milik baris yang ukurannya ikut lebar kolom

local function applyLayout(w)
    local single = w < SINGLE_COL_W
    local colW = single and (w - 28 - 6) or math.floor((w - 28 - 6 - 12) / 2)
    for _, pg in ipairs({ pageFarm, pageStats }) do
        pg.list.FillDirection = single and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
        for _, c in ipairs(pg.cols) do
            c.Size = single and UDim2.new(1, 0, 0, 0) or UDim2.new(0.5, -6, 0, 0)
        end
    end
    for _, fn in ipairs(adaptives) do fn(colW) end
end

