local MODE_ORDER = { "perMile", "payout", "distance" }
local MODE_LABEL = { perMile = "$ / Mile", payout = "Highest Payout", distance = "Shortest" }

local function buildRows(state, capacity, originState, vehTypeId, mileage, fuel)
    local rows = {}
    local payMap = (GameConfig.Economy and GameConfig.Economy.StatePayMultiplier) or {}
    for bizId, b in pairs(state.businesses or {}) do
        if (b.pool or 0) > 0 and (originState == nil or table.find(b.points or {}, originState)) then
            local okCarry, canCarry = pcall(VehicleMath.canCarry, vehTypeId, b.cargo)
            if okCarry and canCarry then
                local origin = originState or (b.points and b.points[1]) or b.headquarters
                if origin then
                    local statePay = payMap[origin] or 1
                    local cargoMult = 1
                    pcall(function() cargoMult = VehicleMath.cargoPayMult(b.cargo) or 1 end)
                    for loadKey, ld in pairs(b.loads or {}) do
                        local dist = math.max(1, ld.distance or 1)
                        local rate = 1
                        local okR, r = pcall(VehicleMath.loadRateMult, bizId, loadKey)
                        if okR and type(r) == "number" then rate = r end
                        local rpp = math.max(1, math.floor(VehicleMath.baseRewardPerPallet(dist) * rate * statePay * (b.spotRate or 1) * cargoMult + 0.5))
                        local payout = math.floor(rpp * math.min(capacity, b.pool) + 0.5)
                        local gallons = 0
                        local okG, g = pcall(VehicleMath.deliveryGallons, vehTypeId, mileage or 0, dist, nil)
                        if okG and type(g) == "number" then gallons = g * 1.15 end
                        rows[#rows + 1] = {
                            bizId = bizId,
                            loadKey = loadKey,
                            origin = origin,
                            destination = ld.destination,
                            cargo = b.cargo,
                            distance = dist,
                            payout = payout,
                            perMile = payout / dist,
                            gallons = gallons,
                        }
                    end
                end
            end
        end
    end
    return rows
end

local function sortRows(rows, mode)
    table.sort(rows, function(a, b)
        if mode == "distance" then
            if a.distance ~= b.distance then return a.distance < b.distance end
            return a.payout > b.payout
        elseif mode == "payout" then
            if a.payout ~= b.payout then return a.payout > b.payout end
            return a.distance < b.distance
        end
        if a.perMile ~= b.perMile then return a.perMile > b.perMile end
        return a.payout > b.payout
    end)
end

