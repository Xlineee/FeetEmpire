local function makeSegmented(parent, opts, getFn, setFn, props)
    local track_ = new("Frame", { BackgroundColor3 = C.white, BackgroundTransparency = 0.88, BorderSizePixel = 0 }, parent)
    for k, v in pairs(props) do track_[k] = v end
    new("UICorner", { CornerRadius = UDim.new(0, 10) }, track_)
    local n = #opts
    local hi = new("Frame", { Size = UDim2.new(1 / n, -4, 1, -4), BackgroundColor3 = C.blue, BorderSizePixel = 0 }, track_)
    new("UICorner", { CornerRadius = UDim.new(0, 8) }, hi)
    local buttons = {}
    local function idxOf(v)
        for i, o in ipairs(opts) do if o[1] == v then return i end end
        return 1
    end
    local function refresh(animate)
        local i = idxOf(getFn())
        local pos = UDim2.new((i - 1) / n, 2, 0, 2)
        if animate then tween(hi, 0.3, { Position = pos }) else hi.Position = pos end
        for j, b in ipairs(buttons) do
            tween(b, 0.2, { TextColor3 = (j == i) and C.white or C.sub })
        end
    end
    for i, o in ipairs(opts) do
        local b = new("TextButton", {
            Size = UDim2.new(1 / n, 0, 1, 0), Position = UDim2.new((i - 1) / n, 0, 0, 0), BackgroundTransparency = 1,
            Text = o[2], Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = C.sub, AutoButtonColor = false,
        }, track_)
        buttons[i] = b
        b.MouseButton1Click:Connect(function()
            setFn(o[1])
            refresh(true)
        end)
    end
    refresh(false)
    return track_
end

local function makeSwitch(parent, getFn, setFn)
    local trackBtn = new("TextButton", {
        Size = UDim2.fromOffset(48, 28), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
        Text = "", AutoButtonColor = false, BackgroundColor3 = C.off,
    }, parent)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, trackBtn)
    local knob = new("Frame", { Size = UDim2.fromOffset(24, 24), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = C.white }, trackBtn)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
    local function apply(animate)
        local on = getFn()
        local col = on and C.green or C.off
        local pos = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
        if animate then
            tween(trackBtn, 0.25, { BackgroundColor3 = col })
            tween(knob, 0.28, { Position = pos }, Enum.EasingStyle.Back)
            tween(knob, 0.12, { Size = UDim2.fromOffset(28, 24) }).Completed:Connect(function()
                tween(knob, 0.16, { Size = UDim2.fromOffset(24, 24) })
            end)
        else
            trackBtn.BackgroundColor3 = col
            knob.Position = pos
        end
    end
    apply(false)
    trackBtn.MouseButton1Click:Connect(function()
        setFn(not getFn())
        apply(true)
    end)
end

local function makeStepper(parent, getFn, setFn, minv, maxv, step, fmtFn)
    local box = new("Frame", {
        Size = UDim2.fromOffset(132, 28), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
        BackgroundColor3 = C.white, BackgroundTransparency = 0.88,
    }, parent)
    new("UICorner", { CornerRadius = UDim.new(0, 9) }, box)
    local val = new("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(30, 0), BackgroundTransparency = 1,
        TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 12,
    }, box)
    local function refresh() val.Text = fmtFn(getFn()) end
    refresh()
    local function btn(txt, x)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(30, 28), Position = x, BackgroundTransparency = 1, Text = txt,
            TextColor3 = C.blue, Font = Enum.Font.GothamBold, TextSize = 18, AutoButtonColor = false,
        }, box)
        b.MouseButton1Down:Connect(function() tween(b, 0.1, { TextSize = 13 }) end)
        b.MouseButton1Up:Connect(function() tween(b, 0.2, { TextSize = 18 }, Enum.EasingStyle.Back) end)
        b.MouseLeave:Connect(function() tween(b, 0.2, { TextSize = 18 }) end)
        return b
    end
    local minus, plus = btn("−", UDim2.fromOffset(0, 0)), btn("+", UDim2.new(1, -30, 0, 0))
    minus.MouseButton1Click:Connect(function() setFn(math.max(minv, getFn() - step)) refresh() end)
    plus.MouseButton1Click:Connect(function() setFn(math.min(maxv, getFn() + step)) refresh() end)
end

