local function minimizedWidth()
    return math.floor(math.clamp(fullW / 2, math.min(fullW, 250), fullW))
end

local function setContent(show)
    tabControl.Visible = show
    footer.Visible = show
    pages[activeKey].Visible = show
end

local minToken = 0
minBtn.MouseButton1Click:Connect(function()
    if resizing then return end
    minimized = not minimized
    minToken += 1
    local my = minToken
    local dur = 0.45
    winBusyUntil = os.clock() + dur

    if minimized then
        resizeBtn.Visible = false
        tween(footer, 0.15, { GroupTransparency = 1 })
        setWindowSize(minimizedWidth(), HEADER, true, dur) -- isi terpotong mengikuti jendela yang mengecil
        task.delay(dur + 0.02, function()
            if minimized and minToken == my then setContent(false) end
        end)
    else
        setContent(true)
        footer.GroupTransparency = 1
        applyLayout(fullW) -- layout disiapkan untuk lebar penuh sebelum melebar
        setWindowSize(fullW, fullH, true, dur)
        task.delay(dur * 0.55, function()
            if not minimized and minToken == my then tween(footer, 0.25, { GroupTransparency = 0 }) end
        end)
        task.delay(dur, function()
            if not minimized and minToken == my then resizeBtn.Visible = true end
        end)
    end
end)

track(UIS.InputBegan:Connect(function(i, processed)
    if processed or i.KeyCode ~= Enum.KeyCode.RightShift or busy then return end
    if visible then closeAnim() else openAnim() end
end))

