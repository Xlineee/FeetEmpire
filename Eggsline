local function fmt(n)
    n = math.floor((tonumber(n) or 0) + 0.5)
    local neg = n < 0
    local out = tostring(math.abs(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    out = out:gsub("^,", "")
    return (neg and "-$" or "$") .. out
end

local function fmtTime(sec)
    sec = math.floor(sec)
    return string.format("%02d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60)
end

local function refreshStats(state)
    if not state or not state.company then return end
    local c = state.company
    local hours = math.max((os.clock() - stats.startClock) / 3600, 1 / 3600)
    local cash = c.cash or 0
    local cashDelta = cash - (stats.startCash or cash)
    local deliv = (state.stats and state.stats.deliveries or 0)
    local delivDelta = deliv - (stats.startDeliveries or deliv)

    local idle, enroute, broken = 0, 0, 0
    for _, v in pairs(c.vehicles or {}) do
        if v.status == "Idle" then idle += 1 elseif v.status == "Broken" then broken += 1 else enroute += 1 end
    end
    local cap = c.fuelCapacity or 0

    statLabels["Waktu jalan"].Text = fmtTime(os.clock() - stats.startClock)
    statLabels["Cash"].Text = fmt(cash)
    statLabels["Cash sesi"].Text = (cashDelta >= 0 and "+" or "") .. fmt(cashDelta)
    statLabels["Cash / jam"].Text = fmt(cashDelta / hours)
    statLabels["Delivery sesi"].Text = tostring(delivDelta)
    statLabels["Delivery / jam"].Text = string.format("%.1f", delivDelta / hours)
    statLabels["Fuel"].Text = cap > 0 and string.format("%.0f%%  (%d/%d gal)", (c.fuel or 0) / cap * 100, math.floor(c.fuel or 0), math.floor(cap)) or "-"
    statLabels["Truck"].Text = string.format("Idle %d • Jalan %d • Rusak %d", idle, enroute, broken)
    statLabels["Dispatch"].Text = string.format("NPC %d • Sendiri %d • Pindah %d", stats.dispatchDriver, stats.dispatchSelf, stats.repositions)
    statLabels["Refuel"].Text = string.format("%dx • %d gal • ~%s", stats.refuels, stats.gallons, fmt(stats.fuelSpent))
    statLabels["Repair"].Text = string.format("%dx • %s", stats.repairs, fmt(stats.repairSpent))
    statLabels["Claim"].Text = string.format("Daily %d • Play %d • Offline %d", stats.daily, stats.playtime, stats.offline)
    statLabels["Aksi"].Text = stats.lastAction
end

