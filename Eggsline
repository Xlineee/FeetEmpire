local function refreshStats(state)
    footerText.Text = stats.lastAction
    if not state or not state.company then return end
    local c = state.company
    local hours = math.max((os.clock() - stats.startClock) / 3600, 1 / 3600)
    local cash = c.cash or 0
    local cashDelta = cash - (stats.startCash or cash)
    local deliv = (state.stats and state.stats.deliveries or 0)
    local delivDelta = deliv - (stats.startDeliveries or deliv)

    local idle, enroute, broken = 0, 0, 0
    for _, v in pairs(c.vehicles or {}) do
        if v.status == "Idle" then idle += 1 elseif v.status == "Broken" then broken += 1 else enroute += 1 end
    end
    local cap = c.fuelCapacity or 0

    statLabels["Waktu jalan"].Text = fmtTime(os.clock() - stats.startClock)
    statLabels["Cash"].Text = fmt(cash)
    statLabels["Cash sesi"].Text = (cashDelta >= 0 and "+" or "") .. fmt(cashDelta)
    statLabels["Cash / jam"].Text = fmt(cashDelta / hours)
    statLabels["Delivery sesi"].Text = tostring(delivDelta)
    statLabels["Delivery / jam"].Text = string.format("%.1f", delivDelta / hours)
    statLabels["Fuel"].Text = cap > 0 and string.format("%.0f%%  (%d/%d gal)", (c.fuel or 0) / cap * 100, math.floor(c.fuel or 0), math.floor(cap)) or "-"
    statLabels["Truck"].Text = string.format("Idle %d • Jalan %d • Rusak %d", idle, enroute, broken)
    statLabels["Dispatch"].Text = string.format("NPC %d • Sendiri %d • Pindah %d", stats.dispatchDriver, stats.dispatchSelf, stats.repositions)
    statLabels["Bank"].Text = fmt(c.bank and c.bank.balance or 0)
    statLabels["Withdraw"].Text = string.format("%dx • %s", stats.withdraws, fmt(stats.withdrawn))
    statLabels["Refuel"].Text = string.format("%dx • %d gal • ~%s", stats.refuels, stats.gallons, fmt(stats.fuelSpent))
    statLabels["Repair"].Text = string.format("%dx • %s", stats.repairs, fmt(stats.repairSpent))
    statLabels["Claim"].Text = string.format("Daily %d • Play %d • Offline %d", stats.daily, stats.playtime, stats.offline)
    statLabels["Aksi"].Text = stats.lastAction
end

-- ===== animasi buka / tutup / minimize =====
local visible, minimized, busy = false, false, false

local function openAnim()
    visible = true
    main.Visible = true
    tween(scale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
    tween(main, 0.35, { GroupTransparency = 0 })
end

local function closeAnim(done)
    visible = false
    tween(scale, 0.3, { Scale = 0.86 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    tween(main, 0.3, { GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    task.delay(0.32, function()
        main.Visible = false
        if done then done() end
    end)
end

local function cleanup()
    env.FleetEmpireRun = -1
    setAntiAfk(false)
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
end
env.FleetEmpireCleanup = cleanup

closeBtn.MouseButton1Click:Connect(function()
    if busy then return end
    busy = true
    closeAnim(cleanup)
end)

minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    local function setContent(show)
        tabControl.Visible = show
        footer.Visible = show
        pages[activeKey].Visible = show
    end
    if minimized then
        task.delay(0.2, function() if minimized then setContent(false) end end)
    else
        setContent(true)
    end
    local targetH = minimized and HEADER or H
    local delta = (minimized and -(H - HEADER) or (H - HEADER)) / 2
    tween(main, 0.45, {
        Size = UDim2.fromOffset(W, targetH),
        Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset, main.Position.Y.Scale, main.Position.Y.Offset + delta),
    }, Enum.EasingStyle.Quint)
end)

track(UIS.InputBegan:Connect(function(i, processed)
    if processed or i.KeyCode ~= Enum.KeyCode.RightShift or busy then return end
    if visible then closeAnim() else openAnim() end
end))

