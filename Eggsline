    StateController = require(lp:WaitForChild("PlayerScripts"):WaitForChild("TransportCo", 10):WaitForChild("Controllers", 10):WaitForChild("StateController", 10))
end)

local cachedState, lastFetch = nil, 0
local function getState()
    if StateController then
        local ok, s = pcall(function() return StateController:Get() end)
        if ok and type(s) == "table" and s.company then return s end
    end
    if os.clock() - lastFetch > 3 then
        lastFetch = os.clock()
        local ok, s = pcall(function() return Remotes.GetState:InvokeServer() end)
        if ok and type(s) == "table" then cachedState = s end
    end
    return cachedState
end

local function fire(name, ...)
    local r = Remotes:FindFirstChild(name)
    if r and r:IsA("RemoteEvent") then
        r:FireServer(...)
        return true
    end
    return false
end

