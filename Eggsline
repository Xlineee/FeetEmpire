local cd = {}
local pendingDispatch = {}
local failedLoads = {}
local lastReposition = {}
local repairCd = {}
local forceRefuel = false
local offState = { at = nil, t = 0 }
local wdPending = nil

local function ready(key, secs)
    local now = os.clock()
    if now < (cd[key] or 0) then return false end
    cd[key] = now + secs
    return true
end

local function pretty(s) return (tostring(s or ""):gsub("(%l)(%u)", "%1 %2")) end

-- claim daily / playtime / offline report
local function doClaims(state)
    if cfg.claimDaily and state.daily and state.daily.claimable == true and ready("daily", 10) then
        if fire("ClaimDaily") then
            stats.daily += 1
            note("Claimed daily reward")
        end
    end

    if cfg.claimPlaytime and state.playtime and type(state.playtime.milestones) == "table" then
        for _, m in pairs(state.playtime.milestones) do
            if m.reached and not m.claimed and ready("pt" .. tostring(m.index), 10) then
                local idx, label = m.index, m.label
                task.spawn(function()
                    local ok, res = pcall(function() return Remotes.ClaimPlaytime:InvokeServer(idx) end)
                    if ok and type(res) == "table" and res.ok then
                        stats.playtime += 1
                        note("Claimed playtime: " .. tostring(label))
                    end
                end)
            end
        end
    end

    local rep = state.company and state.company.offlineReport
    if cfg.offlineReport and rep then
        if rep.at ~= offState.at or os.clock() > offState.t + 20 then
            offState.at = rep.at
            offState.t = os.clock()
            if fire("CollectOfflineReport") then
                stats.offline += 1
                note("Collected offline report")
                pcall(function()
                    for _, d in ipairs(lp.PlayerGui:GetDescendants()) do
                        if d.Name == "OfflineReport" and d:IsA("Frame") then d:Destroy() end
                    end
                end)
            end
        end
    end
end

-- auto withdraw: cash < minCash -> ambil dari bank sebesar kekurangannya
local function doBank(state)
    if not cfg.autoWithdraw then return end
    local c = state.company
    local cash = c.cash or 0
    if cash >= cfg.minCash then
        wdPending = nil
        return
    end
    local balance = math.floor((c.bank and c.bank.balance) or 0)
    if balance <= 0 then return end

    -- tunggu state ter-update setelah withdraw sebelumnya (hindari withdraw ganda)
    if wdPending and os.clock() - wdPending.t < 6 and cash <= wdPending.cash then return end
    if not ready("withdraw", 2) then return end

    local amount = math.floor(math.min(cfg.minCash - cash, balance))
    if amount <= 0 then return end
    if fire("WithdrawFromBank", amount) then
        wdPending = { t = os.clock(), cash = cash }
        stats.withdraws += 1
        stats.withdrawn += amount
        note(string.format("Withdrew $%d from bank", amount))
    end
end

-- auto update: game minta pindah server -> tekan "UPDATE NOW" (RequestUpdate)
local function doUpdate(state)
    if not cfg.autoUpdate then return end
    local u = state.update
    if not (type(u) == "table" and u.available == true) then return end
    if not ready("update", 30) then return end

    if cfg.autoExecute then
        local ok, why = queueReload()
        if not ok then
            note("Update postponed: " .. tostring(why))
            return
        end
    end
    if fire("RequestUpdate") then
        note("Update available -> switching server...")
    end
end

-- refuel
local function doRefuel(state)
    if not cfg.refuel then return end
    local c = state.company
    local cap = c.fuelCapacity or 0
    local fuel = c.fuel or 0
    if cap <= 0 then return end
    local forced = forceRefuel
    if not forced and fuel / cap * 100 > cfg.refuelBelow then return end
    if not ready("refuel", 4) then return end

    local targetPct = forced and 100 or cfg.refuelTo
    local gallons = math.ceil(targetPct / 100 * cap - fuel)
    if gallons < 1 then forceRefuel = false return end

    local price = state.fuelPrice or 20
    gallons = math.min(gallons, math.floor((c.cash or 0) / math.max(price, 0.01) * 0.95))
    if gallons < 1 then return end

    if fire("RefuelCompany", gallons) then
        forceRefuel = false
        stats.refuels += 1
        stats.gallons += gallons
        stats.fuelSpent += gallons * price
        note(string.format("Refuel +%d gal", gallons))
    end
end

-- repair
local COMPONENTS = { "engine", "tires", "brakes", "transmission" }
local function repairDiscount(company)
    local m = company.upgrades and company.upgrades.maintenance
    if m and m.repairPerLevel then
        return math.max(m.repairFloor or 0, 1 - (m.level or 0) * m.repairPerLevel)
    end
    return 1
end

-- The game tracks two different kinds of breakdown:
--   1) Own truck broken down ON THE ROAD (mid delivery): flagged on state.activeDelivery
--      (broken = true, vehicleUid = <truck>). The vehicle's own status is NOT "Broken" here,
--      so it must be fixed with RoadsideRepair.
--   2) Truck parked with status == "Broken" (e.g. NPC truck that broke down): RoadsideRepair does NOT
--      apply ("nothing to repair on the road"), it must be fixed per component / with a full service.
local function roadBreakdown(state, uid)
    local ad = state.activeDelivery
    if type(ad) == "table" and ad.broken and ad.vehicleUid == uid then return ad end
    return nil
end

local lastRepairNote = 0
local function repairNote(msg)
    if os.clock() - lastRepairNote > 10 then
        lastRepairNote = os.clock()
        note(msg)
    end
end

local function calcCost(fn, disc, ...)
    local ok, cost = pcall(fn, ...)
    if ok and type(cost) == "number" then return math.ceil(cost * disc) end
    return 0
end

local function doRepair(state, uid, veh)
    if os.clock() < (repairCd[uid] or 0) then return true end
    local company = state.company
    local cash = company.cash or 0
    local disc = repairDiscount(company)
    local cond = veh.condition or {}
    local label = tostring(veh.plate or uid)

    -- 1) broken down on the road -> roadside repair (only valid while activeDelivery.broken)
    local ad = roadBreakdown(state, uid)
    if ad then
        local comp = ad.breakdownComponent or "engine"
        local cost = calcCost(VehicleMath.roadsideCost, disc, veh.id, comp, cond[comp], veh.mileage)
        if cost > cash then
            repairCd[uid] = os.clock() + 2 -- check again soon (auto withdraw may bring cash in)
            repairNote(string.format("Roadside repair needs $%d (%s)", cost, label))
            return true
        end
        repairCd[uid] = os.clock() + 4
        if fire("RoadsideRepair", uid) then
            stats.repairs += 1
            stats.repairSpent += cost
            note(string.format("Roadside repair: %s (%s)", comp, label))
        end
        return true
    end

    -- 2) parked truck (Idle / Broken) -> component repair or full service
    if veh.status ~= "Idle" and veh.status ~= "Broken" then return false end
    local broken = veh.status == "Broken"

    local need = {}
    for _, comp in ipairs(COMPONENTS) do
        local c = cond[comp] or 100
        if c < cfg.repairBelow and c < 99.5 then need[#need + 1] = { comp = comp, cond = c } end
    end
    if broken and #need == 0 then
        -- a broken truck has at least one failed part: repair the worst one regardless of the threshold
        local worst
        for _, comp in ipairs(COMPONENTS) do
            local c = cond[comp] or 100
            if c < 99.5 and (not worst or c < worst.cond) then worst = { comp = comp, cond = c } end
        end
        if worst then need[1] = worst end
    end
    if #need == 0 then return false end

    -- option: fix ALL components in one go (Full Service)
    if cfg.repairFixAll then
        local cost = calcCost(VehicleMath.fullServiceCost, disc, veh.id, cond, veh.mileage)
        if cost > 0 and cost <= cash then
            repairCd[uid] = os.clock() + 4
            if fire("FullServiceCompanyVehicle", uid) then
                stats.repairs += 1
                stats.repairSpent += cost
                note(string.format("Full service (%s)", label))
                return true
            end
        end
        -- can't afford the full service -> fall through to fixing what we can per component
    end

    local fired = false
    for _, n in ipairs(need) do
        local cost = calcCost(VehicleMath.repairCost, disc, veh.id, n.comp, n.cond, veh.mileage)
        if cost <= cash then
            if fire("RepairCompanyVehicleComponent", uid, n.comp) then
                cash -= cost
                stats.repairs += 1
                stats.repairSpent += cost
                fired = true
                note(string.format("Repair %s (%s)", n.comp, label))
            end
        end
    end
    if fired then
        repairCd[uid] = os.clock() + 3
        return true
    end
    if broken then repairNote("Not enough cash to repair " .. label) end
    return false
end

-- dispatch satu kendaraan (kind = "driver" | "self")
local function doDispatch(state, uid, veh, kind, npc)
    local now = os.clock()
    local mode = (kind == "driver") and cfg.modeDriver or cfg.modeSelf

    local p = pendingDispatch[uid]
    if p then
        if now - p.t < 4 then return end
        failedLoads[uid .. "|" .. p.key] = now + 90
        pendingDispatch[uid] = nil
    end

    local def = Vehicles[veh.id]
    local capacity = def and def.capacity or 0
    if capacity <= 0 then return end
    local fuel = state.company.fuel or 0

    local rows = buildRows(state, capacity, veh.location, veh.id, veh.mileage)
    local usable, blockedByFuel = {}, false
    for _, r in ipairs(rows) do
        if (failedLoads[uid .. "|" .. r.bizId .. "|" .. tostring(r.loadKey)] or 0) <= now then
            if r.gallons <= fuel then
                usable[#usable + 1] = r
            else
                blockedByFuel = true
            end
        end
    end

    if #usable > 0 then
        sortRows(usable, mode)
        local r = usable[1]
        local ok
        if kind == "driver" then
            ok = fire("ManualDispatch", npc.id, r.bizId, r.loadKey)
        else
            ok = fire("AcceptJob", r.bizId, r.loadKey)
        end
        if ok then
            pendingDispatch[uid] = { t = now, key = r.bizId .. "|" .. tostring(r.loadKey) }
            if kind == "driver" then stats.dispatchDriver += 1 else stats.dispatchSelf += 1 end
            note(string.format("%s: %s %s > %s  %d mi  $%d",
                kind == "driver" and (npc.name or "Driver") or "Own truck",
                tostring(r.cargo), pretty(r.origin), pretty(r.destination), r.distance, r.payout))
        end
        return
    end

    if blockedByFuel then
        if cfg.refuel then forceRefuel = true end
        return
    end

    if cfg.reposition and now > (lastReposition[uid] or 0) then
        local all = buildRows(state, capacity, nil, veh.id, veh.mileage)
        local far = {}
        for _, r in ipairs(all) do
            if r.origin ~= veh.location then far[#far + 1] = r end
        end
        sortRows(far, mode)
        local t = far[1]
        if t then
            lastReposition[uid] = now + 45
            local ok
            if kind == "driver" then
                ok = fire("ManualReposition", npc.id, t.origin)
            else
                ok = fire("TravelTo", t.origin)
            end
            if ok then
                stats.repositions += 1
                note(string.format("Moved %s to %s", kind == "driver" and (npc.name or "Driver") or "own truck", pretty(t.origin)))
            end
        end
    end
end

local function processVehicle(state, uid, veh, kind, npc)
    if type(veh) ~= "table" then return end
    local repairOn = (kind == "driver" and cfg.repairDriver) or (kind == "self" and cfg.repairSelf)
    local dispatchOn = (kind == "driver" and cfg.dispatchDriver) or (kind == "self" and cfg.dispatchSelf)

    if veh.status ~= "Idle" then pendingDispatch[uid] = nil end

    if repairOn then
        if doRepair(state, uid, veh) then return end
    end
    if dispatchOn and veh.status == "Idle" then
        doDispatch(state, uid, veh, kind, npc)
    end
end

local function runTick(state)
    local company = state.company
    if not company then return end

    if stats.startCash == nil then
        stats.startCash = company.cash or 0
        stats.startDeliveries = state.stats and state.stats.deliveries or 0
    end

    doUpdate(state)
    doClaims(state)
    doBank(state)      -- cash dulu, baru belanja (refuel / repair)
    doRefuel(state)

    local vehicles = company.vehicles or {}
    if company.myVehicleUid and vehicles[company.myVehicleUid] then
        processVehicle(state, company.myVehicleUid, vehicles[company.myVehicleUid], "self", nil)
    end
    for _, npc in pairs(company.npcs or {}) do
        local uid = npc.assignedVehicleUid
        if uid and vehicles[uid] then
            processVehicle(state, uid, vehicles[uid], "driver", npc)
        end
    end
end

