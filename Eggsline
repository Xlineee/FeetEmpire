local resizing = false
local resizeBtn = new("TextButton", {
    Name = "ResizeHandle", Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -6, 1, -4), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 20,
}, main)
local gripLines = {}
for _, k in ipairs({ { 3, 7 }, { 7, 13 }, { 11, 19 } }) do -- {jarak dari pojok, panjang garis}
    local line = new("Frame", {
        Size = UDim2.fromOffset(k[2], 2), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(24 - k[1], 24 - k[1]), Rotation = -45,
        BackgroundColor3 = C.white, BackgroundTransparency = 0.5, BorderSizePixel = 0, ZIndex = 21,
    }, resizeBtn)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, line)
    gripLines[#gripLines + 1] = line
end
local function gripGlow(on)
    for _, l in ipairs(gripLines) do
        tween(l, 0.15, { BackgroundTransparency = on and 0.05 or 0.5, BackgroundColor3 = on and C.blue or C.white })
    end
end
resizeBtn.MouseEnter:Connect(function() gripGlow(true) end)
resizeBtn.MouseLeave:Connect(function() if not resizing then gripGlow(false) end end)

local rStart, rSize, rPos, rScale, rMaxW, rMaxH
local lastHandleTap = 0

local function saveWindowSize()
    cfg.winW, cfg.winH = math.floor(fullW), math.floor(fullH)
    saveCfg()
end

track(resizeBtn.InputBegan:Connect(function(i)
    if minimized or os.clock() < winBusyUntil then return end
    if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end

    -- tap 2x cepat = kembalikan ke ukuran default
    local now = os.clock()
    if now - lastHandleTap < 0.35 then
        lastHandleTap = 0
        local mw, mh = maxWindowSize()
        fullW, fullH = math.min(W, mw), math.min(H, mh)
        setWindowSize(fullW, fullH, true, 0.35)
        applyLayout(fullW)
        saveWindowSize()
        return
    end
    lastHandleTap = now

    resizing = true
    rStart, rSize, rPos, rScale = i.Position, Vector2.new(fullW, fullH), main.Position, scale.Scale
    rMaxW, rMaxH = maxWindowSize()
    gripGlow(true)
    i.Changed:Connect(function()
        if i.UserInputState == Enum.UserInputState.End and resizing then
            resizing = false
            gripGlow(false)
            saveWindowSize()
        end
    end)
end))

track(UIS.InputChanged:Connect(function(i)
    if not resizing then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = i.Position - rStart
    local nw = math.floor(math.clamp(rSize.X + d.X / rScale, MIN_W, rMaxW))
    local nh = math.floor(math.clamp(rSize.Y + d.Y / rScale, MIN_H, rMaxH))
    fullW, fullH = nw, nh
    main.Size = UDim2.fromOffset(nw, nh)
    main.Position = UDim2.new(
        rPos.X.Scale, rPos.X.Offset + (nw - rSize.X) * rScale / 2,
        rPos.Y.Scale, rPos.Y.Offset + (nh - rSize.Y) * rScale / 2
    )
    applyLayout(nw) -- landscape <-> portrait (2 kolom <-> 1 kolom) otomatis
end))

