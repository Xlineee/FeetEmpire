-- ===== HIDE IDENTITY (mode streamer) =====
-- ON : nama kamu (username + display name) diganti simbol acak yang berganti tiap frame,
--      di panel ini DAN di UI game (mis. di bawah nama company). Hanya visual di sisi kita.
-- OFF: semua teks dikembalikan seperti semula.
local IdentityRun = game:GetService("RunService")
local IDENTITY_INTERVAL = 0 -- jeda antar acak (detik). 0 = tiap frame (secepat mungkin)
local IDENTITY_RESCAN = 4   -- detik, cari teks baru di UI game yang memuat nama kita

local GLYPHS = {}
do
    local function range(a, b) for c = a, b do GLYPHS[#GLYPHS + 1] = c end end
    range(0xFF66, 0xFF9D)          -- katakana half-width (gaya Matrix)
    range(0x2591, 0x2593)          -- ░ ▒ ▓
    GLYPHS[#GLYPHS + 1] = 0x2588   -- █
    for _, b in ipairs({ string.byte("!@#$%&*<>/\\|=+-~0123456789", 1, -1) }) do GLYPHS[#GLYPHS + 1] = b end
end

local function glitch(n)
    local out = table.create(n)
    for i = 1, n do out[i] = utf8.char(GLYPHS[math.random(#GLYPHS)]) end
    return table.concat(out)
end

local idNames = {}
do
    local seen = {}
    for _, n in ipairs({ lp.Name, lp.DisplayName }) do
        local k = n:lower()
        if #n >= 1 and not seen[k] then seen[k] = true idNames[#idNames + 1] = n end
    end
    table.sort(idNames, function(a, b) return #a > #b end) -- nama terpanjang dulu
end

local function isWordChar(c) return c ~= "" and c:match("[%w_]") ~= nil end

-- ganti semua kemunculan nama (tidak peka huruf besar/kecil, hanya kata utuh) dengan simbol acak
local function scramble(text)
    local changed = false
    for _, name in ipairs(idNames) do
        local lt, ln = text:lower(), name:lower()
        local out, i = {}, 1
        while true do
            local s_, e_ = lt:find(ln, i, true)
            if not s_ then break end
            local before = s_ > 1 and text:sub(s_ - 1, s_ - 1) or ""
            local after = text:sub(e_ + 1, e_ + 1)
            if not isWordChar(before) and not isWordChar(after) then
                out[#out + 1] = text:sub(i, s_ - 1)
                out[#out + 1] = glitch(utf8.len(name) or #name)
                changed = true
            else
                out[#out + 1] = text:sub(i, e_)
            end
            i = e_ + 1
        end
        out[#out + 1] = text:sub(i)
        text = table.concat(out)
    end
    return text, changed
end

local identity = { on = false, targets = {}, token = 0 }

local function untrack(label, restore)
    local t = identity.targets[label]
    if not t then return end
    if t.conn then t.conn:Disconnect() end
    identity.targets[label] = nil
    if restore and label.Parent then label.Text = t.orig end
end

local function tryRegister(label)
    if identity.targets[label] then return end
    local text = label.Text
    if text == "" then return end
    local _, found = scramble(text)
    if not found then return end

    local t = { orig = text, last = text, ext = 0 }
    identity.targets[label] = t
    t.conn = label:GetPropertyChangedSignal("Text"):Connect(function()
        if not identity.on then return end
        local cur = label.Text
        if cur == t.last then return end -- perubahan dari kita sendiri
        local _, still = scramble(cur)
        if not still then untrack(label, false) return end -- game menimpa dengan teks lain
        t.orig = cur -- game memperbarui teks (mis. level naik): samarkan langsung
        t.ext += 1
        if t.ext <= 20 then
            t.last = scramble(cur)
            label.Text = t.last
        end
    end)
end

local function isTextGui(d) return d:IsA("TextLabel") or d:IsA("TextButton") end

local function scanGui(root)
    local ok, desc = pcall(function() return root:GetDescendants() end)
    if not ok then return end
    for i, d in ipairs(desc) do
        if isTextGui(d) then tryRegister(d) end
        if i % 3000 == 0 then task.wait() end -- UI game besar, jangan bikin hitch
    end
end

local function setHideIdentity(on)
    on = on and true or false
    if on == identity.on then return end
    identity.on = on
    identity.token += 1
    local token = identity.token

    if on then
        tryRegister(nameLabel)
        tryRegister(subLabel)

        local pg = lp:FindFirstChildOfClass("PlayerGui")
        if pg then
            task.spawn(scanGui, pg)
            identity.added = pg.DescendantAdded:Connect(function(d)
                if isTextGui(d) then task.defer(tryRegister, d) end
            end)
        end

        local acc = 0
        identity.render = IdentityRun.RenderStepped:Connect(function(dt)
            acc += dt
            if acc < IDENTITY_INTERVAL then return end
            acc = 0
            for label, t in pairs(identity.targets) do
                if label.Parent then
                    local new_ = scramble(t.orig)
                    t.last = new_
                    t.ext = 0
                    label.Text = new_
                else
                    untrack(label, false)
                end
            end
            -- nama di atas kepala karakter (hanya tampilan lokal)
            local char = lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.DisplayName = glitch(utf8.len(lp.DisplayName) or #lp.DisplayName) end
        end)

        -- teks baru di UI game yang memuat nama (mis. panel dibuka belakangan)
        task.spawn(function()
            while alive() and identity.on and identity.token == token do
                task.wait(IDENTITY_RESCAN)
                local pg2 = lp:FindFirstChildOfClass("PlayerGui")
                if pg2 and identity.on and identity.token == token then scanGui(pg2) end
            end
        end)
    else
        if identity.render then identity.render:Disconnect() identity.render = nil end
        if identity.added then identity.added:Disconnect() identity.added = nil end
        for label in pairs(identity.targets) do untrack(label, true) end -- kembalikan teks asli
        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.DisplayName = lp.DisplayName end
    end
end

