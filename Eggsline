local queueTeleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
local queued = false

local function loaderSource()
    local url = env.FleetEmpireURL
    if type(url) == "string" and url ~= "" then
        return string.format("loadstring(game:HttpGet(%q))()", url)
    end
    if isfile and isfile(SCRIPT_FILE) then
        return string.format("loadstring(readfile(%q))()", SCRIPT_FILE)
    end
    return nil
end

-- return ok, alasan
local function queueReload()
    if queued then return true end
    if not queueTeleport then return false, "executor tidak punya queue_on_teleport" end
    local src = loaderSource()
    if not src then
        return false, "simpan script ke workspace/" .. SCRIPT_FILE .. " atau set getgenv().FleetEmpireURL"
    end
    queueTeleport("if not game:IsLoaded() then game.Loaded:Wait() end task.wait(3) " .. src)
    queued = true
    return true
end

local rejoining = false
local function rejoin(reason)
    if rejoining then return end
    rejoining = true
    note(reason or "Rejoin...")
    if cfg.autoExecute then queueReload() end
    pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
    task.delay(30, function() rejoining = false end)
end

local tpTries = 0
track(TeleportService.TeleportInitFailed:Connect(function(plr)
    if plr ~= lp or not cfg.autoReconnect or not alive() then return end
    tpTries += 1
    if tpTries > 6 then return end
    note("Teleport gagal, coba lagi (" .. tpTries .. "/6)")
    task.wait(5)
    pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
end))

-- disconnect / server shutdown -> rejoin
task.spawn(function()
    pcall(function()
        local gui = CoreGui:WaitForChild("RobloxPromptGui", 15)
        local overlay = gui and gui:WaitForChild("promptOverlay", 15)
        if overlay then
            track(overlay.ChildAdded:Connect(function(child)
                if child.Name == "ErrorPrompt" and cfg.autoReconnect and alive() then
                    task.wait(2)
                    rejoin("Disconnect terdeteksi, rejoin...")
                end
            end))
        end
    end)
end)
track(GuiService.ErrorMessageChanged:Connect(function()
    if cfg.autoReconnect and alive() and GuiService:GetErrorMessage() ~= "" then
        task.wait(2)
        rejoin("Disconnect terdeteksi, rejoin...")
    end
end))

