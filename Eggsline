local PAGE_Y = HEADER + 42
local function makePage()
    local f = new("ScrollingFrame", {
        Size = UDim2.new(1, -28, 1, -(PAGE_Y + FOOTER + 6)), Position = UDim2.fromOffset(14, PAGE_Y), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = C.sub, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, main)
    local list = new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top,
    }, f)
    new("UIPadding", { PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 6) }, f)
    local cols = {}
    for i = 1, 2 do
        local c = new("Frame", {
            Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = i,
        }, f)
        new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, c)
        c:SetAttribute("n", 0)
        cols[i] = c
    end
    return { frame = f, cols = cols, list = list }
end

